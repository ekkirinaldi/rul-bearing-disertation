## D. Lint script (`scripts/lint-itb.sh`)

Script bash yang memeriksa pelanggaran format ITB yang sering luput:

```bash
#!/usr/bin/env bash
# scripts/lint-itb.sh
# Pemeriksaan otomatis kepatuhan format ITB.
# Exit code != 0 jika ada pelanggaran fatal.

set -uo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
NC='\033[0m'

CHAPTERS="chapters/*.tex"
FATAL=0

ok()    { echo -e "${GREEN}[OK]${NC}    $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $1"; }
fatal() { echo -e "${RED}[FATAL]${NC} $1"; FATAL=1; }

# 1. First-person pronouns (DILARANG)
echo "--- First-person pronouns ---"
hits=$(grep -inE '\b(saya|kami|kita)\b' $CHAPTERS | grep -vE '^[^:]+:[0-9]+:%' || true)
if [ -n "$hits" ]; then
  fatal "Ditemukan kata ganti orang pertama:"
  echo "$hits"
else
  ok "Tidak ada kata ganti orang pertama."
fi

# 2. "et al." (harus "dkk.")
echo "--- 'et al.' usage ---"
hits=$(grep -inE '\bet\s*al\.?' $CHAPTERS | grep -vE '\.bib:' || true)
if [ -n "$hits" ]; then
  fatal "Ditemukan 'et al.' di body (gunakan 'dkk.' di sitasi Indonesia):"
  echo "$hits"
else
  ok "Tidak ada 'et al.' di body."
fi

# 3. Ampersand "&" sebagai pengganti "dan"
echo "--- '&' as conjunction ---"
hits=$(grep -inE '\w\s*&\s*\w' $CHAPTERS | grep -vE 'tabular|align|matrix|cases|begin\{|\\&' || true)
if [ -n "$hits" ]; then
  warn "Ditemukan '&' di luar konteks tabular/math (cek apakah seharusnya 'dan'):"
  echo "$hits"
fi

# 4. Spelling baku
echo "--- Spelling baku ---"
declare -A WRONG_RIGHT=(
  ["obyek"]="objek"
  ["analisa"]="analisis"
  ["sintesa"]="sintesis"
  ["aktifitas"]="aktivitas"
  ["praktek"]="praktik"
  ["nasehat"]="nasihat"
  ["resiko"]="risiko"
  ["atlit"]="atlet"
  ["frekwensi"]="frekuensi"
)
for wrong in "${!WRONG_RIGHT[@]}"; do
  hits=$(grep -inE "\\b${wrong}\\b" $CHAPTERS || true)
  if [ -n "$hits" ]; then
    warn "Ejaan tidak baku '${wrong}' (gunakan '${WRONG_RIGHT[$wrong]}'):"
    echo "$hits"
  fi
done

# 5. Decimal point (English) di body Indonesian — should be comma
echo "--- Decimal separator ---"
hits=$(grep -inE '[0-9]+\.[0-9]+' $CHAPTERS \
  | grep -vE 'I+\.[0-9]+|V+\.[0-9]+|X+\.[0-9]+|chapter|section|figure|table|eq|fig|tab|sec|ref|cite|label|input|include' \
  | grep -vE '\.bib:' || true)
# Heuristik: angka.angka di body Indonesian biasanya salah; tapi banyak false positive
if [ -n "$hits" ]; then
  count=$(echo "$hits" | wc -l)
  if [ "$count" -gt 5 ]; then
    warn "Mungkin ada angka desimal dengan titik (Indonesian: gunakan koma). Verifikasi $count kasus:"
    echo "$hits" | head -10
  fi
fi

# 6. Floating figures/tables yang tidak dirujuk
echo "--- Floats yatim (figure/table tanpa \\ref) ---"
for f in chapters/*.tex; do
  labels=$(grep -oE '\\label\{(fig|tab):[^}]+\}' "$f" | sed -E 's/\\label\{(.*)\}/\1/' || true)
  for lbl in $labels; do
    if ! grep -qE "\\\\(ref|autoref|cref)\{$lbl\}" chapters/*.tex disertasi.tex 2>/dev/null; then
      warn "Float yatim (tidak ada \\ref): $lbl di $f"
    fi
  done
done

# 7. Gambar tanpa caption
echo "--- Figures without \\caption ---"
hits=$(grep -B2 -A8 '\\begin{figure}' $CHAPTERS | grep -L '\\caption' 2>/dev/null || true)
# (Heuristik kasar; lebih reliable: cek tiap figure environment punya caption)

# 8. Sitasi yang belum ada di .bib
echo "--- Citation keys not in .bib ---"
if [ -f references.bib ]; then
  cited=$(grep -ohE '\\(cite|citetitb|citenameitb|parencite|textcite)\{[^}]+\}' chapters/*.tex disertasi.tex 2>/dev/null \
    | sed -E 's/.*\{([^}]+)\}/\1/' | tr ',' '\n' | tr -d ' ' | sort -u)
  defined=$(grep -E '^@[a-zA-Z]+\{' references.bib | sed -E 's/^@[a-zA-Z]+\{([^,]+),.*/\1/' | sort -u)
  missing=$(comm -23 <(echo "$cited") <(echo "$defined"))
  if [ -n "$missing" ]; then
    fatal "Sitasi merujuk key yang tidak ada di references.bib:"
    echo "$missing"
  else
    ok "Semua sitasi terdefinisi di references.bib."
  fi
fi

# Summary
echo
if [ "$FATAL" -eq 0 ]; then
  echo -e "${GREEN}=== Lint passed (no fatal) ===${NC}"
  exit 0
else
  echo -e "${RED}=== Lint FAILED — perbaiki [FATAL] di atas ===${NC}"
  exit 1
fi
```

Beri permission eksekusi: `chmod +x scripts/lint-itb.sh`.

