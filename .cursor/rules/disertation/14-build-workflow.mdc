## C. Makefile — target standar

Buat file `Makefile` di root project. Target wajib:

```make
# ============================================================
#  Disertasi Doktor ITB — Makefile
# ============================================================

MAIN      := disertasi
TEX       := $(MAIN).tex
PDF       := $(MAIN).pdf
BUILDDIR  := build
LATEXMK   := latexmk
LATEXMK_FLAGS := -outdir=$(BUILDDIR) -interaction=nonstopmode -halt-on-error -file-line-error

CHAPTERS  := $(wildcard chapters/*.tex)
ALL_TEX   := $(TEX) $(CHAPTERS)

.PHONY: all build watch clean distclean wordcount check spell lint pre-submit help

all: build

build:    ## Compile sekali (lualatex + biber + lualatex x2)
	@mkdir -p $(BUILDDIR)
	$(LATEXMK) $(LATEXMK_FLAGS) $(TEX)
	@cp $(BUILDDIR)/$(PDF) ./$(PDF)

watch:    ## Compile otomatis saat file berubah (latexmk -pvc)
	@mkdir -p $(BUILDDIR)
	$(LATEXMK) $(LATEXMK_FLAGS) -pvc $(TEX)

clean:    ## Hapus file build menengah, simpan PDF
	$(LATEXMK) -outdir=$(BUILDDIR) -c $(TEX)

distclean:## Hapus seluruh direktori build dan PDF
	$(LATEXMK) -outdir=$(BUILDDIR) -C $(TEX)
	rm -rf $(BUILDDIR)
	rm -f $(PDF)

wordcount:## Hitung jumlah kata per bab
	@echo "=== Word count per chapter ==="
	@for f in $(CHAPTERS); do \
		echo "--- $$f ---"; \
		texcount -inc -1 -sum "$$f" || true; \
	done
	@echo "=== Total (estimasi) ==="
	@texcount -inc -1 -sum -merge $(TEX) || true

check:    ## Jalankan semua quality check (lint + regex + spell)
	@echo "=== chktex ==="
	@chktex -q -n8 -n24 $(ALL_TEX) || true
	@$(MAKE) lint
	@echo "=== Done. Lihat output di atas. ==="

lint:     ## Regex check: forbidden phrases, format issues
	@bash scripts/lint-itb.sh

spell:    ## Spell check (Indonesian + inggris untuk Bab Abstract)
	@hunspell -d id_ID -t -l $(filter-out chapters/00-abstract-en.tex,$(CHAPTERS)) | sort -u | head -50
	@echo "(snippet 50 first errors; jalankan 'hunspell -d id_ID -t' interaktif untuk fix)"

pre-submit: clean build wordcount check spell ## Jalankan sebelum kirim ke promotor
	@echo "=== Pre-submit checks selesai. Periksa output di atas sebelum submit. ==="

help:     ## Tampilkan daftar target ini
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'
```

Cara pakai paling sering:

```bash
make watch       # selama menulis aktif — auto-compile setiap save
make pre-submit  # sebelum kirim draft ke promotor
make wordcount   # cek panjang per bab
```

