# =============================================================================
# Datasets (too large for git — see research/data-bearing/README.md for download)
# =============================================================================
# Use /* (not /) so the directory itself remains traversable and the README
# below can be re-included with a negation pattern.
research/data-bearing/*
!research/data-bearing/README.md
!research/data-bearing/.gitkeep

# Derived feature/parquet caches (regenerable from raw datasets)
data/cache/
**/data_cache/
**/hi_cache/

# =============================================================================
# Python environments and bytecode
# =============================================================================
.venv/
venv/
env/
**/.venv/
**/venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# =============================================================================
# ML training artefacts
# =============================================================================
# Heavy raw run logs (regenerable). Reports under results/reports/ ARE kept.
**/results/runs/
**/results/checkpoints/
**/results/_logs/
**/lightning_logs/
**/mlruns/
wandb/
*.ckpt
*.pt
*.pth
*.safetensors

# =============================================================================
# Keep dissertation evidence (override broader patterns above)
# =============================================================================
!research/Mamba-xLSTM/results/
!research/Mamba-xLSTM/results/reports/
!research/Mamba-xLSTM/results/reports/**
!research/Mamba-xLSTM/results/_chapter_assets/
!research/Mamba-xLSTM/results/_chapter_assets/**
!research/Mamba-xLSTM/results/bpfx_mapping/
!research/Mamba-xLSTM/results/bpfx_mapping/**
!research/Mamba-xLSTM/results/_comparison_configs/
!research/Mamba-xLSTM/results/_comparison_configs/**
!research/Mamba-xLSTM/results/tables/
!research/Mamba-xLSTM/results/tables/**

# =============================================================================
# LaTeX build artefacts (keep .tex/.bib source, drop generated PDFs/aux files)
# =============================================================================
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb
# Seminar drafts, ITB reference files and other material kept only on disk
archive/local/

# =============================================================================
# Word and PowerPoint files are untracked unless re-included below
# =============================================================================
*.docx
*.pptx
# The June LaTeX-to-DOCX port, kept for traceability
!archive/docx-port/**/*.docx
# The ITB Word template the manuscript is built on
!manuscript/assets/*.docx

# Re-include the current V-series manuscript draft. One line per version on
# purpose: each DOCX is ~18 MB and git cannot delta-compress it (a DOCX is
# already a deflate-compressed zip), so every tracked version costs its full
# size. Add the next version here deliberately rather than tracking V*.docx.
!manuscript/V16*.docx

# Earlier versions, backups and the circulated sidang deck stay local
manuscript/versions/

# Build output of the archived port
archive/docx-port/build/

# journal-q2 working draft (separate publication, not dissertation core)
writings/journal-q2/

# =============================================================================
# Inference engine — keep source, exclude Python caches
# =============================================================================
research/inference-engine/**/__pycache__/
research/inference-engine/**/*.py[cod]

# =============================================================================
# OS / IDE / temporary files
# =============================================================================
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# Ad-hoc extraction artefacts from .docx ingestion (V5 → LaTeX integration)
.tmp_*
**/.tmp_*
.venv-docx/
**/.venv-docx/

# =============================================================================
# Editor workspace files and local notes (kept on disk, not in git)
# =============================================================================
.cursor/
.claude/
CLAUDE.md
AGENTS.md

# Loose PDFs at repo root (paper drafts, keep locally)
*.pdf
